# Base URL of the backend REST API (json-server demo: npm run api).
API_URL=http://localhost:4000

# Auth.js secret (generate: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Public site URL used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image storage (required for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
